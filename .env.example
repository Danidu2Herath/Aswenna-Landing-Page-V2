# =============================================================================
#  ASWENNA — the one environment file
#
#  Copy to .env and fill in:   cp .env.example .env
#  .env is gitignored and must never be committed. So is every other .env
#  variant (.env.production, .env.staging, ...). Only this template is tracked.
#
#  Full guide: docs/FORM-AND-SECRETS.md
# =============================================================================


# -----------------------------------------------------------------------------
#  SECTION 1 — PUBLIC.  Everything below is VISIBLE TO EVERY VISITOR.
#
#  Vite replaces each VITE_* name with its literal value when the site is
#  built. The value ends up in the JavaScript served to the browser and can be
#  read with View Source. There is no server to withhold it, and encrypting
#  this file does not change it — the build decrypts before it inlines.
#
#  A VITE_ variable is configuration, not a secret. Never put a password, an
#  API key, a database URL or a signing secret here. `npm run build` runs
#  scripts/check-env.mjs, which stops the build if you do.
# -----------------------------------------------------------------------------

# The canonical origin of the deployed site. No trailing slash.
# Feeds canonical URLs, sitemap.xml, robots.txt, Open Graph and JSON-LD.
VITE_SITE_URL=https://aswenna.veyra.lk

# Where the contact form POSTs. Must accept a JSON body and answer 2xx.
#
# FormSubmit needs no API key, but the inbox must be activated ONCE: submit
# the form on the live site, then click the link in the confirmation email.
# Note the address is part of this URL, so it is public. Formspree and
# Web3Forms hide the destination behind an opaque id instead.
VITE_CONTACT_ENDPOINT=https://formsubmit.co/ajax/info@veyra.lk

# How long to wait for the relay before showing the error state, in ms.
VITE_CONTACT_TIMEOUT_MS=15000


# -----------------------------------------------------------------------------
#  SECTION 2 — SECRET.  Server-side only. NO VITE_ PREFIX, EVER.
#
#  A name without the VITE_ prefix is never inlined into the bundle. These are
#  read only by code that runs on a server — a serverless function, a build
#  step — and never reach the browser.
#
#  The site as it stands needs none of these. They are listed so that when one
#  is needed it goes in the right half of this file. See section 5 of
#  docs/FORM-AND-SECRETS.md for a working function that uses them.
#
#  In production these belong in the host's SECRET store (Cloudflare Pages
#  secrets, Netlify environment variables marked secret, Vercel Sensitive
#  environment variables) rather than in a file on disk.
# -----------------------------------------------------------------------------

# Key for the mail provider a server function would send through.
# MAIL_API_KEY=

# The inbox a server function delivers to, kept out of the public bundle.
# CONTACT_INBOX=info@veyra.lk

# Secret half of a CAPTCHA pair. The site key is public; this one is not.
# TURNSTILE_SECRET_KEY=


# Cloudflare Web Analytics site token (Cloudflare dashboard > Web Analytics >
# your site > manual JS snippet). Public by design. Leave empty to omit the
# beacon. It is added to production builds only, never to `vite dev`.
# VITE_CF_BEACON_ID=
