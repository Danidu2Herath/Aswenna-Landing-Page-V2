# =============================================================================
#  ASWENNA — environment template
#  Copy this file to .env and fill it in:   cp .env.example .env
#  .env is gitignored and must never be committed.
# =============================================================================
#
#  WARNING — VITE_ VARIABLES ARE NOT SECRET.
#  Vite inlines every VITE_* value into the JavaScript bundle at build time,
#  so each one is readable by anyone who opens View Source on the live site.
#  Put only public configuration here. A real secret (SMTP password, API key
#  with write access, database URL) needs a server or serverless function; a
#  static site cannot hide one.
#
# -----------------------------------------------------------------------------

# The canonical origin of the deployed site. No trailing slash.
# Used for canonical URLs, sitemap.xml, robots.txt, Open Graph and JSON-LD.
VITE_SITE_URL=https://aswenna.lk

# Where the contact form POSTs. Must accept a JSON body and answer 2xx.
#
# FormSubmit needs no API key, but the inbox must be activated ONCE: submit
# the form on the live site, then click the link in the confirmation email
# FormSubmit sends to that address. Until that is done every submission fails
# and the visitor sees the error state.
#
# Alternatives, if you would rather the address were not in the bundle:
#   Formspree    https://formspree.io/f/YOUR_FORM_ID
#   Web3Forms    https://api.web3forms.com/submit     (uses an access key)
#   Your own     https://api.example.com/contact
VITE_CONTACT_ENDPOINT=https://formsubmit.co/ajax/info@veyra.lk

# How long to wait for the relay before showing the error state, in ms.
VITE_CONTACT_TIMEOUT_MS=15000
