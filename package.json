{
  "name": "aswenna-landing",
  "private": true,
  "version": "2.0.0",
  "description": "Aswenna \u2014 Agricultural Intelligence Platform landing page (React + TypeScript + SCSS)",
  "type": "module",
  "scripts": {
    "dev": "npm run seo && vite",
    "build": "npm run seo && tsc -b && vite build && npm run prerender",
    "preview": "vite preview --port 4173",
    "seo": "node scripts/gen-image-sizes.mjs && node --experimental-strip-types scripts/gen-seo.mjs",
    "icons": "node scripts/build-icons.mjs",
    "lint": "oxlint",
    "og": "node scripts/make-og.mjs",
    "prerender": "vite build --ssr src/entry-server.tsx --outDir dist-ssr --logLevel warn && node scripts/prerender.mjs",
    "images": "node scripts/gen-image-sizes.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "sass": "^1.83.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
